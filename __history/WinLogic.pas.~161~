procedure FreePlayersList;
var
  i: Integer;
begin
  for i := 0 to High(PlayersList) do
  begin
    if Assigned(PlayersList[i].BitmapOrig) then
      PlayersList[i].BitmapOrig.Free;
    if Assigned(PlayersList[i].BitmapCopy) then
      PlayersList[i].BitmapCopy.Free;
  end;

  SetLength(PlayersList, 0); // очищаем сам массив
end;




procedure ShowWinTable;
var
  i: Integer;
  lblPlayer, lblScore: TLabel;
  MaxScore: Integer;
begin
  ShowPanel(MainForm.pnlWinTable);

  SortTopPlayers;
  MaxScore := PlayersList[0].Score;


  for i := 0 to High(PlayersList) do
  begin
    lblPlayer := TLabel.Create(MainForm);
    lblScore := TLabel.Create(MainForm);

    with lblPlayer do
    begin
      Parent := MainForm.fpWinTable;
      Caption := PlayersList[i].Name;
      Autosize := false;
      Width := 330;
      Height := 50;
      Font.Size := 12;
      Alignment := taCenter;
      Layout := tlCenter;
      Transparent := false;
      AlignWithMargins := true;

      with Margins do
      begin
        Top := 4;
        Left := 4;
        Bottom := 4;
        Right := 4;
      end;
    end;



    with lblScore do
    begin
      Parent := MainForm.fpWinTable;
      Caption := IntToStr(PlayersList[i].Score);
      Autosize := false;
      Width := 100;
      Height := 50;
      Font.Size := 12;
      Alignment := taCenter;
      Layout := tlCenter;
      Transparent := false;
      AlignWithMargins := true;

      with Margins do
      begin
        Top := 4;
        Left := 4;
        Bottom := 4;
        Right := 4;
      end;
    end;

    if PlayersList[i].Score = MaxScore then
    begin
      lblPlayer.Color := WinColor;
      lblScore.Color := WinColor;
    end
    else
    begin
      lblPlayer.Color := StandartColor;
      lblScore.Color := StandartColor;
    end;

  end;
end;




