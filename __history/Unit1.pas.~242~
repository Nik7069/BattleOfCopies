unit Unit1;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants,
  System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Vcl.StdCtrls,

  // Мои юниты
  GameLogic;

type
  TForm1 = class(TForm)
    Timer1: TTimer;
    Button1: TButton;
    Button2: TButton;
    pnlGame: TPanel;
    PaintBox1: TPaintBox;
    pnlMenu: TPanel;
    btnStart: TButton;
    pnlSetRules: TPanel;
    Button3: TButton;
    ComboBox1: TComboBox;
    ComboBox2: TComboBox;
    procedure PaintBox1MouseUp(Sender: TObject; Button: TMouseButton;
      Shift: TShiftState; X, Y: Integer);
    procedure PaintBox1MouseDown(Sender: TObject; Button: TMouseButton;
      Shift: TShiftState; X, Y: Integer);
    procedure PaintBox1MouseMove(Sender: TObject; Shift: TShiftState;
      X, Y: Integer);
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure PaintBox1Paint(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure btnStartClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form1: TForm1;
//  MX, MY, PMX, PMY: Integer;
  MyColor: TColor;
  Size: Integer = 8;
  MClick: Boolean;
  Bitmap: TBitmap;
  Dest, Source: TRect;

implementation

uses PointConverter;

{$R *.dfm}

procedure ShowPanel(Panel: TPanel);
begin
  Form1.pnlGame.Visible := False;
  Form1.pnlMenu.Visible := False;

  Panel.Visible := True;
  Panel.BringToFront;
end;


procedure TForm1.FormCreate(Sender: TObject);
begin
  CreateBitmap;
  GameLogic.Size := 202;
  ShowMessage(GameLogic.Size);
end;


procedure TForm1.btnStartClick(Sender: TObject);
begin
  ShowPanel(pnlGame);
end;

procedure TForm1.Button1Click(Sender: TObject);
begin
  ShowPanel(pnlGame);
end;

procedure TForm1.Button2Click(Sender: TObject);
begin
  ShowPanel(pnlMenu);
end;

procedure TForm1.PaintBox1MouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
begin
  PaintMouseDown(X, Y);
end;

procedure TForm1.PaintBox1MouseMove(Sender: TObject; Shift: TShiftState;
  X, Y: Integer);
begin
  PaintMouseMove(X, Y);
end;

procedure TForm1.PaintBox1MouseUp(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
begin
  PaintMouseUp;
end;

procedure TForm1.PaintBox1Paint(Sender: TObject);
begin

  LoadPaint;

end;

end.
